<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Semantic Image Search</title>
  <link rel="icon" type="image/ico" href="/favicon.ico">
  <link rel="stylesheet" href="/styles/build.css">
</head>
<body class="flex flex-col items-center min-h-screen p-8 bg-gray-100">

  <!-- Title with favicon -->
  <h1 class="flex items-center space-x-2 text-3xl font-bold">
    <span>Semantic Image Search</span>

    <a href="/info" target="_blank" title="System Info"> 
      <img src="/favicon.png" alt="favicon" class="w-8 h-8">
    </a>

    <a href="/upload" target="_blank"
        class="text-blue-600 transition hover:text-blue-800"
        title="Upload image">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none"
            viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M4 16v1a2 2 0 002 2h12a2 2 0 002-2v-1M12 12V4m0 0l-4 4m4-4l4 4" />
        </svg>
    </a>

  </h1>    
    
  <p class="mb-6 text-gray-700 w-120">
    “To search images by text description...Sometimes it is accurate, other times it is humorous, but more often than not, it is a JOKE.”
  </p>

  <!-- Search Form -->
  <form id="searchForm" class="flex mb-8 space-x-2">
    <input id="query" name="query" type="text" required
      placeholder="Enter text..."
      class="px-4 py-2 border rounded w-80 focus:outline-none focus:ring-2 focus:ring-blue-400" autoFocus>

    <!-- Search button -->
    <button type="submit"
      class="px-6 py-2 text-white bg-blue-500 rounded hover:bg-blue-600">
      Search
    </button>
  </form>

  <!-- Results Grid -->
  <div id="results" class="grid w-full max-w-5xl grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">    
  </div>

  <!-- Footer -->
  <footer class="mt-12 text-sm text-gray-700">
    Powered by 
    <a href="https://www.sqlite.org/" class="text-blue-500 hover:underline" target="_blank">SQLite</a> 
    and 
    <a href="https://github.com/asg017/sqlite-vec" class="text-blue-500 hover:underline" target="_blank">sqlite-vec</a>, 
    written by 
    <a href="https://copilot.microsoft.com" class="text-blue-500 hover:underline" target="_blank">Copilot</a> 
    © <%= new Date().getFullYear() %>
  </footer>

  <!-- Client-side fetch -->
  <script type="module">
    const form = document.getElementById('searchForm');
    
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const query = document.getElementById('query').value;
      const res = await fetch('/api/v1/search', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ query })
      });
      const data = await res.json();

      const resultsDiv = document.getElementById('results');
      resultsDiv.innerHTML = '';
      data.forEach(({ rowid, distance }, index) => {
        const card = document.createElement('div');
        card.className = 'bg-white shadow rounded overflow-hidden';
        card.innerHTML = `
          <div class="flex justify-between p-2 font-bold">
            <span>${index + 1}. </span>
            <span>distance:  ${distance.toFixed(4)} </span>
          </div>

          <a href="/image/${rowid}" target="_blank">
            <img src="/api/v1/preview/${rowid}"
                 alt="Image ${rowid}"
                 class="object-cover w-full h-64 transition hover:opacity-80">
          </a>
        `;
        resultsDiv.appendChild(card);
      });
    });
  </script>

</body>
</html>
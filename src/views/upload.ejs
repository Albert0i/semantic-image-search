<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Semantic Image Search</title>
  <link rel="icon" type="image/ico" href="/favicon.ico">
  <link rel="stylesheet" href="/styles/build.css">
</head>
<body class="flex flex-col items-center min-h-screen p-8 bg-gray-100">

  <!-- Title -->
  <h1 class="flex items-center space-x-2 text-3xl font-bold">
    <span>Image Upload</span>
  </h1>   

  <!-- Main Content -->
  <main class="flex justify-center w-full mt-4">

    <div class="flex justify-center w-full mt-12">
      <form id="uploadForm" action="/upload" method="POST" enctype="multipart/form-data"
            class="w-full max-w-md p-6 space-y-4 bg-white border border-gray-300 rounded-lg shadow-md">
    
        <label for="fileInput" class="block mb-2 font-semibold text-gray-700">Upload Images</label>
    
        <div id="dropZone"
              class="flex items-center justify-center p-12 text-sm text-gray-700 transition border-2 border-blue-400 border-dashed rounded-lg cursor-pointer hover:bg-blue-50">
          Drag & drop images here or click to select
        </div>
    
        <input id="fileInput" type="file" name="images" multiple accept="image/*"
                class="hidden" />
    
        <div id="fileList" class="mt-2 text-sm text-gray-900"></div>
    
        <button type="submit" id="uploadBtn" 
                class="w-full px-4 py-2 font-semibold text-white transition rounded bg-cyan-600 hover:bg-cyan-700 disabled:bg-gray-400 disabled:cursor-not-allowed">
          Upload
        </button>
        
        <p id="uploadStatus" style="display:none;">Uploading in progress…</p>
        <div id='message' class="mb-4 font-medium text-black"><%= message %></div>
        
      </form>

    </div>
    
    <script>
      const dropZone = document.getElementById('dropZone');
      const uploadForm = document.getElementById('uploadForm');
      const fileInput = document.getElementById('fileInput');
      const uploadBtn = document.getElementById('uploadBtn');
      const uploadStatus = document.getElementById('uploadStatus');
      const messageBox = document.getElementById('message');
      const fileList = document.getElementById('fileList');
      const MAX_FILES = <%= max %>;  // Maximum files upload at one time
    
      dropZone.addEventListener('click', () => fileInput.click());
    
      dropZone.addEventListener('dragover', (e) => {
        e.preventDefault();
        dropZone.classList.add('bg-blue-100');
      });
    
      dropZone.addEventListener('dragleave', () => {
        dropZone.classList.remove('bg-blue-100');
      });
    
      dropZone.addEventListener('drop', (e) => {
        e.preventDefault();
        dropZone.classList.remove('bg-blue-100');
        fileInput.files = e.dataTransfer.files;
        updateFileList();
      });
    
      // fileInput.addEventListener('change', updateFileList);
      fileInput.addEventListener('change', () => {
          if (fileInput.files.length > MAX_FILES) {
            console.log('fileInput.files.length = ', fileInput.files.length)
            
            messageBox.textContent = `Please upload no more than ${MAX_FILES} images at a time.`;
            messageBox.classList.add('text-red-600');
            fileInput.value = ''; // Clear selection
            fileList.innerHTML = ''; // Clear preview
          } else {
            messageBox.textContent = '';
            messageBox.classList.remove('text-red-600');
            updateFileList();
          }
        });
    
      function updateFileList() {
        const files = fileInput.files;
        fileList.innerHTML = '';
        for (let i = 0; i < files.length; i++) {
          const item = document.createElement('div');
          item.textContent = `${i + 1}. ${files[i].name}`;
          fileList.appendChild(item);
        }
      }
    
      uploadForm.addEventListener('submit', (e) => {
        messageBox.textContent = ''; // Clear previous message

        if (!fileInput.files || fileInput.files.length === 0) {
          e.preventDefault();
          messageBox.textContent = 'Please select at least one image before uploading.';
          messageBox.classList.add('text-red-600');
        } else {
          messageBox.classList.remove('text-red-600');
          uploadBtn.disabled = true;
          uploadStatus.style.display = 'block';
        }
      });
    </script>

  </main>
  
  <div class="flex items-center justify-center h-6 mt-12">
    <button onclick="window.close()"
            class="inline-block px-4 py-2 text-white transition bg-blue-500 rounded cursor-pointer hover:bg-blue-600">
      Close
    </button>
  </div>

  <!-- Footer -->
  <footer class="mt-12 text-sm text-gray-700">
    Powered by 
    <a href="https://www.sqlite.org/" class="text-blue-500 hover:underline" target="_blank">SQLite</a> 
    and 
    <a href="https://github.com/asg017/sqlite-vec" class="text-blue-500 hover:underline" target="_blank">sqlite-vec</a>, 
    written by 
    <a href="https://copilot.microsoft.com" class="text-blue-500 hover:underline" target="_blank">Copilot</a> 
    © <%= new Date().getFullYear() %>
  </footer>

</body>
</html>